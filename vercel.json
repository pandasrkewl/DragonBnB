{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/listing/:propertyId/book",
      "destination": "/api/index.js"
    },
    {
      "source": "/listing",
      "destination": "/api/index.js"
    },
    {
      "source": "/messages",
      "destination": "/api/index.js"
    },
    {
      "source": "/profile",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ]
}